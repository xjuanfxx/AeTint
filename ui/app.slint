// AeTint · interfaz (todo cabe en una ventana, sin scroll). La ventana se pinta con la misma paleta que se va a aplicar a After Effects.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/ArchivoExpanded-SemiBold.ttf";
import "fonts/ArchivoExpanded-ExtraBold.ttf";
import "fonts/JetBrainsMono-Medium.ttf";

export struct ColorEntry {
    key: string,
    label: string,
    hint: string,
    hex: string,
    value: color,
    custom: bool,
}

export struct TargetItem {
    id: string,
    label: string,
    status: string,
    selected: bool,
}

export struct PresetItem {
    name: string,
    base: color,
    panel: color,
    raised: color,
    text: color,
    accent: color,
}

export struct Hsv {
    h: float,
    s: float,
    v: float,
}

export struct Preview {
    base: color,
    panel: color,
    frame: color,
    raised: color,
    text: color,
    muted: color,
    accent: color,
    on-accent: color,
    tl-bg: color,
    grid: color,
    ruler: color,
    ruler-border: color,
    nav: color,
    work: color,
    work-edge: color,
    cti: color,
    layer: color,
    layer-sel: color,
    key-sel: color,
}

export global Ui {
    in-out property <Preview> p;
    // idioma: inglés por defecto, español si es = true
    in-out property <bool> es: false;
    public pure function t(en: string, es-text: string) -> string { return self.es ? es-text : en; }
    pure callback hsv-color(float, float, float) -> color;
    pure callback hsv-hex(float, float, float) -> string;
    pure callback hex-hsv(string) -> Hsv;
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 40px;
    min-width: txt.preferred-width + 36px;
    border-radius: 10px;
    background: !enabled ? Ui.p.raised : primary ? (ta.has-hover ? Ui.p.accent.brighter(0.12) : Ui.p.accent) : (ta.has-hover ? Ui.p.frame : transparent);
    border-width: primary ? 0 : 1px;
    border-color: Ui.p.frame;
    drop-shadow-blur: primary && enabled ? 16px : 0;
    drop-shadow-color: Ui.p.accent.with-alpha(0.35);
    animate background { duration: 120ms; }
    txt := Text {
        text: root.text;
        color: !enabled ? Ui.p.muted : primary ? Ui.p.on-accent : Ui.p.text;
        font-family: "Archivo Expanded";
        font-size: 12.5px;
        font-weight: 800;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Check inherits Rectangle {
    in property <bool> checked;
    width: 16px;
    height: 16px;
    border-radius: 5px;
    border-width: 1.5px;
    border-color: checked ? Ui.p.accent : Ui.p.muted;
    background: checked ? Ui.p.accent : transparent;
    Text {
        visible: checked;
        text: "✓";
        color: Ui.p.on-accent;
        font-size: 11px;
        font-weight: 700;
    }
}

component Switch inherits Rectangle {
    in property <bool> on;
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background: on ? Ui.p.accent : Ui.p.raised;
    border-width: 1px;
    border-color: on ? Ui.p.accent : Ui.p.frame;
    animate background { duration: 150ms; }
    Rectangle {
        x: on ? parent.width - self.width - 3px : 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: on ? Ui.p.on-accent : Ui.p.muted;
        animate x { duration: 150ms; easing: ease-out; }
    }
}

// Botones de la barra de título propia (minimizar, maximizar/restaurar, cerrar)
component WinBtn inherits Rectangle {
    in property <int> kind; // 0 minimizar, 1 maximizar, 2 cerrar
    in property <bool> maxed;
    callback clicked;
    width: 46px;
    height: 32px;
    background: ta.has-hover ? (kind == 2 ? #e81123 : Ui.p.frame) : transparent;
    animate background { duration: 90ms; }
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: ta.has-hover && kind == 2 ? #ffffff : Ui.p.text;
        stroke-width: 1px;
        fill: transparent;
        commands: kind == 0 ? "M 0 5.5 L 10 5.5" : kind == 2 ? "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5" : maxed ? "M 2.5 0.5 L 9.5 0.5 L 9.5 7.5 M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z" : "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z";
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Cap inherits Text {
    color: Ui.p.muted;
    font-family: "Archivo Expanded";
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.4px;
}

component Card inherits Rectangle {
    border-radius: 16px;
    background: Ui.p.panel.with-alpha(0.82);
    border-width: 1px;
    border-color: Ui.p.frame.with-alpha(0.7);
}

// Logo: gota (el tinte) con una mini timeline dentro: tres capas y el cabezal.
component Logo inherits Rectangle {
    in property <length> size: 36px;
    property <length> u: self.size / 32;
    width: size;
    height: size;
    border-radius: size * 0.28;
    background: @linear-gradient(135deg, Ui.p.accent.brighter(0.35) 0%, Ui.p.accent 50%, Ui.p.accent.darker(0.45) 100%);
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: Ui.p.accent.with-alpha(0.4);
    Path {
        x: 0;
        y: 0;
        width: root.size;
        height: root.size;
        viewbox-width: 32;
        viewbox-height: 32;
        fill: white;
        commands: "M16 4.5 C16 4.5 8.5 12.6 8.5 18.3 A7.5 7.5 0 0 0 23.5 18.3 C23.5 12.6 16 4.5 16 4.5 Z";
    }
    for b in [{ x: 11.0, y: 15.6, w: 7.5 }, { x: 13.0, y: 18.6, w: 8.0 }, { x: 11.5, y: 21.6, w: 5.5 }]: Rectangle {
        x: root.u * b.x;
        y: root.u * b.y;
        width: root.u * b.w;
        height: root.u * 1.9;
        border-radius: root.u;
        background: Ui.p.base;
    }
    Rectangle { x: root.u * 17.4; y: root.u * 12.6; width: root.u * 1.2; height: root.u * 11.8; background: Ui.p.accent.darker(0.1); }
    Rectangle { x: root.u * 16.5; y: root.u * 11.4; width: root.u * 3; height: root.u * 2.2; border-radius: root.u * 0.7; background: Ui.p.accent.darker(0.1); }
}

component Picker inherits Rectangle {
    in-out property <float> h;
    in-out property <float> s;
    in-out property <float> v;
    callback changed(string);
    width: 236px;
    height: 230px;

    Rectangle {
        background: Ui.p.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Ui.p.frame;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000080;

        sv := Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: 160px;
            border-radius: 8px;
            clip: true;
            background: @linear-gradient(90deg, #ffffff 0%, Ui.hsv-color(root.h, 1, 1) 100%);
            Rectangle {
                background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
            }
            Rectangle {
                x: root.s * sv.width - 7px;
                y: (1 - root.v) * sv.height - 7px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 2px;
                border-color: white;
                background: Ui.hsv-color(root.h, root.s, root.v);
            }
            TouchArea {
                mouse-cursor: crosshair;
                function upd() {
                    root.s = max(0, min(1, self.mouse-x / sv.width));
                    root.v = max(0, min(1, 1 - self.mouse-y / sv.height));
                    root.changed(Ui.hsv-hex(root.h, root.s, root.v));
                }
                pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.upd(); } }
                moved => { if (self.pressed) { self.upd(); } }
            }
        }

        hue := Rectangle {
            x: 12px;
            y: 184px;
            width: parent.width - 24px;
            height: 16px;
            border-radius: 8px;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.6%, #00ff00 33.3%, #00ffff 50%, #0000ff 66.6%, #ff00ff 83.3%, #ff0000 100%);
            Rectangle {
                x: root.h * hue.width - 4px;
                width: 8px;
                height: parent.height + 4px;
                border-radius: 4px;
                border-width: 2px;
                border-color: white;
                background: transparent;
            }
            TouchArea {
                mouse-cursor: pointer;
                function upd() {
                    root.h = max(0, min(0.999, self.mouse-x / hue.width));
                    root.changed(Ui.hsv-hex(root.h, root.s, root.v));
                }
                pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.upd(); } }
                moved => { if (self.pressed) { self.upd(); } }
            }
        }

        Text {
            x: 12px;
            y: 206px;
            text: Ui.hsv-hex(root.h, root.s, root.v);
            color: Ui.p.muted;
            font-size: 11px;
            font-family: "Consolas";
        }
    }
}

// Fila de la paleta: muestra · nombre · hex
component ColorRow inherits Rectangle {
    in property <ColorEntry> entry;
    callback changed(string);
    property <float> ph;
    property <float> ps;
    property <float> pv;
    height: 38px;
    border-radius: 10px;
    background: ta-row.has-hover ? Ui.p.raised.with-alpha(0.6) : transparent;
    ta-row := TouchArea { }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: root.entry.value;
                border-width: 1px;
                border-color: Ui.p.frame;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.ph = Ui.hex-hsv(root.entry.hex).h;
                        root.ps = Ui.hex-hsv(root.entry.hex).s;
                        root.pv = Ui.hex-hsv(root.entry.hex).v;
                        popup.show();
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.entry.label; color: Ui.p.text; font-size: 12.5px; font-weight: 600; }
            Text { text: root.entry.hint; color: Ui.p.muted; font-size: 10.5px; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 78px;
                height: 26px;
                border-radius: 7px;
                background: Ui.p.raised;
                border-width: 1px;
                border-color: hex.has-focus ? Ui.p.accent : Ui.p.frame;
                hex := TextInput {
                    x: 9px;
                    width: parent.width - 18px;
                    vertical-alignment: center;
                    text: root.entry.hex;
                    color: Ui.p.text;
                    font-size: 11.5px;
                    font-family: "JetBrains Mono";
                    single-line: true;
                    accepted => { root.changed(self.text); }
                    edited => { if (self.text.character-count == 7) { root.changed(self.text); } }
                }
            }
        }
    }

    popup := PopupWindow {
        x: root.width + 10px;
        y: -90px;
        width: 236px;
        height: 230px;
        close-policy: close-on-click-outside;
        Picker {
            h <=> root.ph;
            s <=> root.ps;
            v <=> root.pv;
            changed(hx) => { root.changed(hx); }
        }
    }
}

// Ficha de un color de la timeline: muestra · nombre · casilla. Sin marcar sigue la paleta.
component TlChip inherits Rectangle {
    in property <ColorEntry> entry;
    callback changed(string);
    callback toggled(bool);
    property <float> ph;
    property <float> ps;
    property <float> pv;
    height: 50px;
    border-radius: 11px;
    background: entry.custom ? Ui.p.raised : (ta.has-hover ? Ui.p.raised.with-alpha(0.5) : transparent);
    border-width: 1px;
    border-color: entry.custom ? Ui.p.accent.with-alpha(0.55) : Ui.p.frame;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.entry.custom); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 7px;
                background: root.entry.value;
                border-width: 1px;
                border-color: Ui.p.frame;
                opacity: root.entry.custom ? 1 : 0.55;
                Rectangle {
                    visible: root.entry.custom;
                    x: parent.width - 9px;
                    y: -5px;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: Ui.p.accent;
                    border-width: 2px;
                    border-color: Ui.p.raised;
                    Text { text: "✓"; color: Ui.p.on-accent; font-size: 8px; font-weight: 700; }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (!root.entry.custom) { root.toggled(true); }
                        root.ph = Ui.hex-hsv(root.entry.hex).h;
                        root.ps = Ui.hex-hsv(root.entry.hex).s;
                        root.pv = Ui.hex-hsv(root.entry.hex).v;
                        popup.show();
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            Text { text: root.entry.label; color: Ui.p.text; font-size: 11px; font-weight: 600; overflow: elide; }
            Text {
                text: root.entry.custom ? root.entry.hex : Ui.t("Automatic", "Automático");
                color: root.entry.custom ? Ui.p.text.mix(Ui.p.muted, 0.4) : Ui.p.muted;
                font-size: 10px;
                font-family: root.entry.custom ? "JetBrains Mono" : "Inter";
            }
        }
    }
    popup := PopupWindow {
        x: 0;
        y: -240px;
        width: 236px;
        height: 230px;
        close-policy: close-on-click-outside;
        Picker {
            h <=> root.ph;
            s <=> root.ps;
            v <=> root.pv;
            changed(hx) => { root.changed(hx); }
        }
    }
}

// Maqueta de After Effects con los colores que se van a escribir.
component AePreview inherits Rectangle {
    border-radius: 12px;
    clip: true;
    background: Ui.p.base;
    border-width: 1px;
    border-color: Ui.p.frame;

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        // menú + barra de herramientas
        Rectangle {
            height: 30px;
            border-radius: 6px;
            background: Ui.p.frame;
            HorizontalLayout {
                padding-left: 10px;
                spacing: 14px;
                for m in ["File", "Edit", "Composition", "Layer", "Effect", "Animation", "View", "Window", "Help"]: Text {
                    text: m;
                    color: Ui.p.text;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 1;
            // proyecto
            Rectangle {
                width: 22%;
                border-radius: 6px;
                background: Ui.p.panel;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    alignment: start;
                    Text { text: "Project"; color: Ui.p.text; font-size: 11px; font-weight: 600; }
                    Rectangle { height: 20px; border-radius: 5px; background: Ui.p.raised; }
                    for i in 4: Rectangle {
                        height: 14px;
                        border-radius: 3px;
                        background: i == 1 ? Ui.p.accent.with-alpha(0.35) : transparent;
                        Text { x: 6px; text: "Comp " + (i + 1); color: Ui.p.muted; font-size: 10px; }
                    }
                }
            }
            // visor
            Rectangle {
                border-radius: 6px;
                background: Ui.p.panel;
                Rectangle {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    border-radius: 4px;
                    background: Ui.p.raised;
                    Rectangle {
                        width: 46%;
                        height: 56%;
                        background: #000;
                        border-width: 1px;
                        border-color: Ui.p.frame;
                    }
                }
            }
            // efectos
            Rectangle {
                width: 20%;
                border-radius: 6px;
                background: Ui.p.panel;
                VerticalLayout {
                    padding: 8px;
                    spacing: 5px;
                    alignment: start;
                    Text { text: "Effects & Presets"; color: Ui.p.text; font-size: 11px; font-weight: 600; }
                    for i in 5: Text { text: "› Category " + (i + 1); color: Ui.p.muted; font-size: 10px; }
                }
            }
        }
        // timeline
        Rectangle {
            height: 46%;
            border-radius: 6px;
            background: Ui.p.panel;
            HorizontalLayout {
                // columnas de capas
                Rectangle {
                    width: 38%;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 0px;
                        alignment: start;
                        Rectangle { height: 22px; Text { x: 4px; text: "0:00:00:00"; color: Ui.p.accent; font-size: 12px; font-weight: 600; } }
                        Rectangle { height: 18px; Text { x: 4px; text: "Source Name"; color: Ui.p.muted; font-size: 10px; } }
                        for i in 3: Rectangle {
                            height: 20px;
                            background: i == 0 ? Ui.p.frame : transparent;
                            Text { x: 6px; text: (i + 1) + "   Layer " + (i + 1); color: Ui.p.text; font-size: 10px; }
                        }
                    }
                }
                // área de tiempo
                Rectangle {
                    background: Ui.p.tl-bg;
                    clip: true;
                    // navegador de tiempo
                    Rectangle {
                        y: 4px;
                        x: 6px;
                        width: parent.width - 12px;
                        height: 8px;
                        border-radius: 2px;
                        background: Ui.p.nav;
                    }
                    // regla
                    Rectangle {
                        y: 16px;
                        height: 24px;
                        background: Ui.p.ruler;
                        Rectangle { y: parent.height - 1px; height: 1px; background: Ui.p.ruler-border; }
                        for i in 12: Rectangle {
                            x: (i + 0.5) * parent.width / 12;
                            y: parent.height - 7px;
                            width: 1px;
                            height: 6px;
                            background: Ui.p.muted;
                        }
                    }
                    // área de trabajo
                    Rectangle {
                        y: 40px;
                        x: 6px;
                        width: parent.width * 0.7;
                        height: 6px;
                        background: Ui.p.work;
                        border-width: 1px;
                        border-color: Ui.p.work-edge;
                    }
                    // barras de capa
                    for i in 3: Rectangle {
                        x: 6px + i * 14px;
                        y: 52px + i * 20px;
                        width: parent.width * (0.82 - i * 0.12);
                        height: 16px;
                        border-radius: 2px;
                        background: i == 0 ? Ui.p.layer-sel : Ui.p.layer;
                        Text {
                            x: parent.width * 0.3;
                            text: "◆";
                            font-size: 11px;
                            color: i == 0 ? Ui.p.key-sel : Ui.p.muted;
                        }
                    }
                    // líneas de cuadrícula
                    for i in 4: Rectangle {
                        y: 70px + i * 20px;
                        height: 1px;
                        background: Ui.p.grid;
                    }
                    // CTI
                    Rectangle {
                        x: parent.width * 0.42;
                        y: 14px;
                        width: 1px;
                        height: parent.height;
                        background: Ui.p.cti;
                        Rectangle { y: 0; x: -5px; width: 11px; height: 10px; border-radius: 2px; background: Ui.p.cti; }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "AeTint";
    no-frame: true;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 1100px;
    min-height: 740px;
    background: Ui.p.base;
    default-font-family: "Inter";

    in property <[TargetItem]> targets;
    in property <[PresetItem]> presets;
    in property <[ColorEntry]> palette;
    in property <[ColorEntry]> timeline;
    in property <string> status;
    in property <bool> status-error;
    in property <bool> status-ok;
    // botón junto al aviso: "Apply" con cambios sin aplicar, "Retry" tras un error ("" = sin botón)
    in property <string> status-action;
    callback status-act();
    in property <bool> busy;
    in property <bool> is-max;
    // destello breve del aviso cuando cambia el mensaje
    property <float> flash: 0;
    property <color> status-color: root.status-error ? #f38ba8 : root.busy ? #f9e2af : root.status-ok ? #a6e3a1 : Ui.p.accent;
    changed status => {
        root.flash = 1;
        flash-timer.running = true;
    }
    flash-timer := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            root.flash = 0;
            self.running = false;
        }
    }
    in-out property <bool> menus;
    in-out property <bool> autostart;

    callback toggle-target(string, bool);
    callback set-palette(string, string);
    callback set-override(string, string);
    callback toggle-override(string, bool);
    callback use-preset(int);
    callback apply();
    callback restore();
    callback rescan();
    callback toggle-menus(bool);
    callback toggle-autostart(bool);
    callback set-lang(bool);
    // temas guardados por el usuario
    in property <[PresetItem]> themes;
    callback save-theme(string);
    callback apply-theme(int);
    callback delete-theme(int);
    // brillo que se edita: oscuro (Darkest y Dark de AE) o claro (Light)
    in property <bool> edit-light;
    callback set-edit-light(bool);
    // versión actual y, si hay una más nueva en GitHub, su número
    in property <string> app-version;
    in property <string> update-version;
    // descarga de la actualización en curso (0..1)
    in property <bool> update-busy;
    in property <float> update-progress;
    callback open-update();
    property <int> lib-tab: 0;
    callback start-drag();
    callback start-resize(int);
    callback win-minimize();
    callback win-maximize();
    callback win-close();

    // brillos de fondo con el acento
    Rectangle {
        x: -260px;
        y: -300px;
        width: 760px;
        height: 760px;
        background: @radial-gradient(circle, Ui.p.accent.with-alpha(0.16) 0%, Ui.p.accent.with-alpha(0) 70%);
    }
    Rectangle {
        x: root.width - 520px;
        y: root.height - 460px;
        width: 820px;
        height: 820px;
        background: @radial-gradient(circle, Ui.p.accent.with-alpha(0.10) 0%, Ui.p.accent.with-alpha(0) 70%);
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 72px;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.start-drag(); }
            }
            double-clicked => { root.win-maximize(); }
        }
    }

    // contenido con ancho máximo, centrado en pantallas grandes (maximizado)
    Rectangle {
    x: max(0px, (root.width - 1600px) / 2);
    y: 0;
    width: min(root.width, 1600px);
    height: root.height;
    VerticalLayout {
        padding: 16px;
        padding-top: 14px;
        spacing: 14px;

        // ── cabecera (también es la barra de título: se arrastra y con doble clic se maximiza)
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            // sitio para los botones de ventana, que van pegados al borde de la ventana
            padding-right: root.is-max ? 0px : 138px;
            VerticalLayout { alignment: center; Logo { size: 40px; } }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "AeTint";
                        color: Ui.p.text;
                        font-family: "Archivo Expanded";
                        font-size: 22px;
                        font-weight: 800;
                    }
                    // versión actual, o aviso de actualización (pulsar abre la Release)
                    VerticalLayout {
                        alignment: center;
                        if root.update-version == "": Text {
                            text: "v" + root.app-version;
                            color: Ui.p.muted;
                            font-family: "JetBrains Mono";
                            font-size: 10.5px;
                        }
                        if root.update-version != "": Rectangle {
                            height: 20px;
                            width: upd-row.preferred-width + 20px;
                            border-radius: 10px;
                            background: upd-ta.has-hover && !root.update-busy ? Ui.p.accent.brighter(0.12) : Ui.p.accent;
                            clip: true;
                            // relleno de progreso mientras se descarga
                            Rectangle {
                                x: 0;
                                width: root.update-busy ? parent.width * root.update-progress : 0;
                                background: Ui.p.on-accent.with-alpha(0.22);
                                animate width { duration: 150ms; }
                            }
                            // centrada en la pastilla (10 px a cada lado por el ancho de arriba)
                            upd-row := HorizontalLayout {
                                spacing: 5px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Ui.p.on-accent;
                                        opacity: 0.45 + 0.55 * Math.abs(Math.sin(animation-tick() / 6ms * 1deg));
                                    }
                                }
                                Text {
                                    text: !root.update-busy ? Ui.t("Update", "Actualizar") + " v" + root.update-version
                                        : root.update-progress < 1 ? Ui.t("Downloading", "Descargando") + " " + Math.round(root.update-progress * 100) + "%"
                                        : Ui.t("Installing…", "Instalando…");
                                    color: Ui.p.on-accent;
                                    font-family: "Archivo Expanded";
                                    font-size: 9.5px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                            }
                            upd-ta := TouchArea {
                                mouse-cursor: root.update-busy ? default : pointer;
                                clicked => { root.open-update(); }
                            }
                        }
                    }
                }
                Text { text: Ui.t("After Effects themes · panels, timeline and menus", "Temas para After Effects · paneles, timeline y menús"); color: Ui.p.muted; font-size: 11px; }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 88px;
                    height: 32px;
                    border-radius: 16px;
                    background: Ui.p.panel.with-alpha(0.82);
                    border-width: 1px;
                    border-color: Ui.p.frame.with-alpha(0.7);
                    // pastilla que se desliza bajo el idioma elegido
                    Rectangle {
                        x: Ui.es ? parent.width / 2 : 3px;
                        y: 3px;
                        width: parent.width / 2 - 3px;
                        height: parent.height - 6px;
                        border-radius: 13px;
                        background: Ui.p.accent;
                        animate x { duration: 160ms; easing: ease-out; }
                    }
                    HorizontalLayout {
                        for l[k] in ["EN", "ES"]: Rectangle {
                            Text {
                                text: l;
                                color: (k == 1) == Ui.es ? Ui.p.on-accent : Ui.p.muted;
                                font-family: "Archivo Expanded";
                                font-size: 10.5px;
                                font-weight: 800;
                                letter-spacing: 0.8px;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { if ((k == 1) != Ui.es) { root.set-lang(k == 1); } }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;

            // ── columna izquierda: presets, paleta, menús
            Card {
                width: 346px;
                VerticalLayout {
                    padding: 16px;
                    padding-top: 14px;
                    spacing: 8px;

                    // pestañas: presets incluidos / temas guardados por el usuario
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        height: 18px;
                        for tab[k] in [{ en: "PRESETS", es: "PRESETS" }, { en: "MY THEMES", es: "MIS TEMAS" }]: Rectangle {
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                Cap {
                                    text: Ui.t(tab.en, tab.es) + (k == 1 && root.themes.length > 0 ? "  " + root.themes.length : "");
                                    color: root.lib-tab == k ? Ui.p.text : tabta.has-hover ? Ui.p.text.mix(Ui.p.muted, 0.5) : Ui.p.muted;
                                }
                                Rectangle {
                                    height: 2px;
                                    border-radius: 1px;
                                    background: root.lib-tab == k ? Ui.p.accent : transparent;
                                }
                            }
                            tabta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.lib-tab = k; }
                            }
                        }
                    }
                    if root.lib-tab == 0: VerticalLayout {
                        height: 170px;
                        spacing: 6px;
                        for r in (root.presets.length + 1) / 2: HorizontalLayout {
                            spacing: 6px;
                            for c in 2: chip := Rectangle {
                                property <int> i: r * 2 + c;
                                property <PresetItem> pr: root.presets[chip.i];
                                height: 38px;
                                horizontal-stretch: 1;
                                min-width: 0;
                                preferred-width: 10px;
                                opacity: chip.i < root.presets.length ? 1 : 0;
                                border-radius: 10px;
                                background: chip.pr.base;
                                border-width: 1px;
                                border-color: pta.has-hover ? Ui.p.accent : chip.pr.panel.mix(chip.pr.text, 0.85);
                                animate border-color { duration: 120ms; }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: -5px;
                                        horizontal-stretch: 0;
                                        for col in [chip.pr.panel, chip.pr.accent, chip.pr.text]: VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                border-radius: 6px;
                                                background: col;
                                                border-width: 1.5px;
                                                border-color: chip.pr.base;
                                            }
                                        }
                                    }
                                    Text {
                                        text: chip.pr.name;
                                        color: chip.pr.text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                                pta := TouchArea {
                                    enabled: chip.i < root.presets.length;
                                    mouse-cursor: pointer;
                                    clicked => { root.use-preset(chip.i); }
                                }
                            }
                        }
                    }

                    if root.lib-tab == 1: VerticalLayout {
                        height: 170px;
                        spacing: 6px;
                        // nombre + guardar
                        HorizontalLayout {
                            spacing: 6px;
                            height: 32px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 8px;
                                background: Ui.p.raised;
                                border-width: 1px;
                                border-color: tname.has-focus ? Ui.p.accent : Ui.p.frame;
                                tname := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    vertical-alignment: center;
                                    color: Ui.p.text;
                                    font-size: 12px;
                                    single-line: true;
                                    accepted => {
                                        if (self.text != "") {
                                            root.save-theme(self.text);
                                            self.text = "";
                                        }
                                    }
                                }
                                Text {
                                    x: 10px;
                                    visible: tname.text == "";
                                    text: Ui.t("Name your colours…", "Ponle nombre a tus colores…");
                                    color: Ui.p.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                            }
                            Rectangle {
                                width: 74px;
                                border-radius: 8px;
                                background: tname.text == "" ? Ui.p.raised : sva.has-hover ? Ui.p.accent.brighter(0.12) : Ui.p.accent;
                                Text {
                                    text: Ui.t("Save", "Guardar");
                                    color: tname.text == "" ? Ui.p.muted : Ui.p.on-accent;
                                    font-family: "Archivo Expanded";
                                    font-size: 11px;
                                    font-weight: 800;
                                }
                                sva := TouchArea {
                                    enabled: tname.text != "";
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.save-theme(tname.text);
                                        tname.text = "";
                                    }
                                }
                            }
                        }
                        if root.themes.length == 0: Rectangle {
                            vertical-stretch: 1;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Ui.p.frame;
                            Text {
                                width: parent.width - 32px;
                                text: Ui.t("No saved themes yet. Adjust your colours, give them a name and press Save.", "Aún no hay temas guardados. Ajusta tus colores, ponles nombre y pulsa Guardar.");
                                color: Ui.p.muted;
                                font-size: 11.5px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }
                        if root.themes.length > 0: Flickable {
                            vertical-stretch: 1;
                            content-height: root.themes.length * 34px;
                            for th[i] in root.themes: Rectangle {
                                y: i * 34px;
                                width: parent.width;
                                height: 30px;
                                border-radius: 8px;
                                background: rta.has-hover ? Ui.p.raised : transparent;
                                rta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.apply-theme(i); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 4px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: -4px;
                                        horizontal-stretch: 0;
                                        for col in [th.base, th.panel, th.accent, th.text]: VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 14px;
                                                height: 14px;
                                                border-radius: 7px;
                                                background: col;
                                                border-width: 1.5px;
                                                border-color: Ui.p.panel;
                                            }
                                        }
                                    }
                                    Text {
                                        text: th.name;
                                        color: Ui.p.text;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        width: 24px;
                                        visible: rta.has-hover || dta.has-hover;
                                        border-radius: 6px;
                                        background: dta.has-hover ? #f38ba833 : transparent;
                                        Text {
                                            text: "×";
                                            color: dta.has-hover ? #f38ba8 : Ui.p.muted;
                                            font-size: 15px;
                                        }
                                        dta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.delete-theme(i); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 4px; }
                    HorizontalLayout {
                        Cap { text: Ui.t("YOUR COLOURS", "TUS COLORES"); vertical-alignment: center; horizontal-stretch: 1; }
                        // paleta oscura (Darkest y Dark de AE) o clara (Light)
                        Rectangle {
                            width: 132px;
                            height: 22px;
                            border-radius: 11px;
                            background: Ui.p.raised;
                            border-width: 1px;
                            border-color: Ui.p.frame;
                            Rectangle {
                                x: root.edit-light ? parent.width / 2 : 2px;
                                y: 2px;
                                width: parent.width / 2 - 2px;
                                height: parent.height - 4px;
                                border-radius: 9px;
                                background: Ui.p.accent;
                                animate x { duration: 160ms; easing: ease-out; }
                            }
                            HorizontalLayout {
                                for m[k] in [{ en: "DARK", es: "OSCURO" }, { en: "LIGHT", es: "CLARO" }]: Rectangle {
                                    Text {
                                        text: Ui.t(m.en, m.es);
                                        color: (k == 1) == root.edit-light ? Ui.p.on-accent : Ui.p.muted;
                                        font-family: "Archivo Expanded";
                                        font-size: 9px;
                                        font-weight: 800;
                                        letter-spacing: 0.8px;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { if ((k == 1) != root.edit-light) { root.set-edit-light(k == 1); } }
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 0px;
                        for e in root.palette: ColorRow {
                            entry: e;
                            changed(hx) => { root.set-palette(e.key, hx); }
                        }
                    }

                    Rectangle { height: 4px; }
                    Cap { text: Ui.t("MENUS AND TITLE BAR", "MENÚS Y BARRA DE TÍTULO"); }
                    for opt[k] in [
                        { label: Ui.t("Paint File, Edit… and the title bar", "Pintar File, Edit… y el título"), on: root.menus },
                        { label: Ui.t("Start with Windows", "Activar al iniciar Windows"), on: root.autostart },
                    ]: Rectangle {
                        height: 32px;
                        opacity: k == 1 && !root.menus ? 0.45 : 1;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 4px;
                            Text {
                                text: opt.label;
                                color: Ui.p.text;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            VerticalLayout { alignment: center; Switch { on: opt.on; } }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            enabled: k == 0 || root.menus;
                            clicked => {
                                if (k == 0) { root.toggle-menus(!root.menus); } else { root.toggle-autostart(!root.autostart); }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // ── derecha: vista previa, timeline, instalaciones y botones
            VerticalLayout {
                spacing: 14px;
                AePreview { vertical-stretch: 1; min-height: 250px; }

                Card {
                    VerticalLayout {
                        padding: 14px;
                        padding-top: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            Cap { text: "TIMELINE"; vertical-alignment: center; }
                            Text {
                                text: Ui.t("Tick a colour to set it by hand; unticked ones follow your palette.", "Marca un color para fijarlo a mano; sin marcar sigue tu paleta.");
                                color: Ui.p.muted;
                                font-size: 10.5px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            for e in root.timeline: TlChip {
                                horizontal-stretch: 1;
                                min-width: 0;
                                preferred-width: 10px;
                                entry: e;
                                changed(hx) => { root.set-override(e.key, hx); }
                                toggled(on) => { root.toggle-override(e.key, on); }
                            }
                        }
                    }
                }

                Card {
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        if root.targets.length == 0: Text {
                            text: Ui.t("After Effects wasn't found in Program Files.", "No se encontró After Effects en Program Files.");
                            color: Ui.p.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        for t in root.targets: Rectangle {
                            height: 44px;
                            // con varias versiones las tarjetas se encogen (el texto se recorta) en vez de empujar la ventana
                            min-width: 112px;
                            preferred-width: 180px;
                            horizontal-stretch: 0;
                            border-radius: 11px;
                            background: t.selected ? Ui.p.raised : (tta.has-hover ? Ui.p.raised.with-alpha(0.5) : transparent);
                            border-width: 1px;
                            border-color: t.selected ? Ui.p.accent.with-alpha(0.55) : Ui.p.frame;
                            HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 14px;
                                spacing: 10px;
                                VerticalLayout { alignment: center; Check { checked: t.selected; } }
                                VerticalLayout {
                                    alignment: center;
                                    min-width: 0;
                                    horizontal-stretch: 1;
                                    Text { text: t.label; color: Ui.p.text; font-size: 12px; font-weight: 700; overflow: elide; }
                                    Text { text: t.status; color: Ui.p.muted; font-size: 10.5px; overflow: elide; }
                                }
                            }
                            tta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-target(t.id, !t.selected); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                text: Ui.t("Restore originals", "Restaurar originales");
                                enabled: !root.busy;
                                clicked => { root.restore(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                text: root.busy ? Ui.t("Working…", "Aplicando…") : Ui.t("Apply theme", "Aplicar tema");
                                primary: true;
                                enabled: !root.busy;
                                min-width: 150px;
                                clicked => { root.apply(); }
                            }
                        }
                    }
                }
            }
        }
    }

    }

    // aviso de estado, centrado en la ventana
    HorizontalLayout {
        x: 330px;
        y: 14px;
        width: max(0px, root.width - 660px);
        height: 44px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                max-width: 520px;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    ring := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 22px;
                        height: 22px;
                        border-radius: self.width / 2;
                        border-width: 1.5px;
                        border-color: root.status-color;
                        opacity: 0;
                    }
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.status-color;
                        opacity: root.busy ? 0.4 + 0.6 * Math.abs(Math.sin(animation-tick() / 3ms * 1deg)) : 1;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0;
                    border-radius: 7px;
                    // un error se puede abrir entero (los largos se recortan con "…")
                    background: root.status-error && msg-ta.has-hover ? #f38ba8.with-alpha(0.10) : transparent;
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        msg := Text {
                            text: root.status;
                            color: root.status-error ? #f38ba8 : Ui.p.text.mix(Ui.p.muted, 0.4);
                            font-size: 12.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    msg-ta := TouchArea {
                        enabled: root.status-error;
                        mouse-cursor: root.status-error ? pointer : default;
                        clicked => { details.show(); }
                    }
                    details := PopupWindow {
                        x: 0;
                        y: parent.height + 8px;
                        width: 460px;
                        close-policy: close-on-click-outside;
                        Rectangle {
                            background: Ui.p.raised;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #f38ba8.with-alpha(0.5);
                            drop-shadow-blur: 18px;
                            drop-shadow-color: #00000066;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text {
                                    text: Ui.t("Error details", "Detalles del error");
                                    color: #f38ba8;
                                    font-size: 11px;
                                    font-weight: 800;
                                    letter-spacing: 0.6px;
                                }
                                TextInput {
                                    text: root.status;
                                    read-only: true;
                                    single-line: false;
                                    wrap: word-wrap;
                                    color: Ui.p.text;
                                    font-size: 12px;
                                    selection-background-color: Ui.p.accent.with-alpha(0.45);
                                }
                                Text {
                                    text: Ui.t("Select the text and press Ctrl+C to copy it.", "Selecciona el texto y pulsa Ctrl+C para copiarlo.");
                                    color: Ui.p.muted;
                                    font-size: 10.5px;
                                }
                            }
                        }
                    }
                }
                if root.status-action != "" : Rectangle {
                    height: 24px;
                    width: act-label.preferred-width + 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 12px;
                    background: act-ta.pressed ? root.status-color.with-alpha(0.32) : act-ta.has-hover ? root.status-color.with-alpha(0.22) : root.status-color.with-alpha(0.13);
                    border-width: 1px;
                    border-color: root.status-color.with-alpha(0.55);
                    animate background { duration: 120ms; }
                    act-label := Text {
                        text: root.status-action;
                        color: root.status-color;
                        font-size: 11.5px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    act-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.status-act(); }
                    }
                }
            }
            states [
                lit when root.flash > 0.5: {
                    ring.width: 8px;
                    ring.height: 8px;
                    ring.opacity: 1;
                    msg.color: root.status-color;
                    in {
                        animate ring.width, ring.height, ring.opacity, msg.color { duration: 0ms; }
                    }
                    out {
                        animate ring.width, ring.height { duration: 750ms; easing: ease-out; }
                        animate ring.opacity { duration: 750ms; easing: ease-in; }
                        animate msg.color { duration: 1200ms; easing: ease-in-out; }
                    }
                }
            ]
        }

    }

    HorizontalLayout {
        x: root.width - 138px;
        y: 0;
        width: 138px;
        height: 32px;
        WinBtn { kind: 0; clicked => { root.win-minimize(); } }
        WinBtn { kind: 1; maxed: root.is-max; clicked => { root.win-maximize(); } }
        WinBtn { kind: 2; clicked => { root.win-close(); } }
    }

    // borde fino de la ventana
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        border-width: root.is-max ? 0 : 1px;
        border-color: Ui.p.frame;
    }

    // bordes para cambiar el tamaño (0 N, 1 S, 2 E, 3 O, 4 NE, 5 NO, 6 SE, 7 SO)
    for z in [
        { d: 0, x: 8px, y: 0px, w: root.width - 16px - 140px, h: 5px },
        { d: 1, x: 8px, y: root.height - 5px, w: root.width - 16px, h: 5px },
        { d: 2, x: root.width - 5px, y: 32px, w: 5px, h: root.height - 40px },
        { d: 3, x: 0px, y: 8px, w: 5px, h: root.height - 16px },
        { d: 5, x: 0px, y: 0px, w: 8px, h: 8px },
        { d: 6, x: root.width - 8px, y: root.height - 8px, w: 8px, h: 8px },
        { d: 7, x: 0px, y: root.height - 8px, w: 8px, h: 8px },
    ]: TouchArea {
        x: z.x;
        y: z.y;
        width: z.w;
        height: z.h;
        enabled: !root.is-max;
        mouse-cursor: z.d == 0 || z.d == 1 ? ns-resize : z.d == 2 || z.d == 3 ? ew-resize : z.d == 5 || z.d == 6 ? nwse-resize : nesw-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.start-resize(z.d); }
        }
    }
}
