// AeTint · interfaz (todo cabe en una ventana, sin scroll). La ventana se pinta con la misma paleta que se va a aplicar a After Effects.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/ArchivoExpanded-SemiBold.ttf";
import "fonts/ArchivoExpanded-ExtraBold.ttf";
import "fonts/JetBrainsMono-Medium.ttf";

export struct ColorEntry {
    key: string,
    label: string,
    hint: string,
    hex: string,
    value: color,
    custom: bool,
}

export struct TargetItem {
    id: string,
    label: string,
    status: string,
    selected: bool,
}

export struct PresetItem {
    name: string,
    base: color,
    panel: color,
    raised: color,
    text: color,
    accent: color,
}

export struct Hsv {
    h: float,
    s: float,
    v: float,
}

export struct Preview {
    base: color,
    panel: color,
    frame: color,
    raised: color,
    text: color,
    muted: color,
    accent: color,
    on-accent: color,
    tl-bg: color,
    grid: color,
    ruler: color,
    ruler-border: color,
    nav: color,
    work: color,
    work-edge: color,
    cti: color,
    layer: color,
    layer-sel: color,
    key-sel: color,
}

export global Ui {
    in-out property <Preview> p;
    // idioma: inglés por defecto, español si es = true
    in-out property <bool> es: false;
    public pure function t(en: string, es-text: string) -> string { return self.es ? es-text : en; }
    pure callback hsv-color(float, float, float) -> color;
    pure callback hsv-hex(float, float, float) -> string;
    pure callback hex-hsv(string) -> Hsv;
    // el cuadro de saturación y brillo de un tono, como imagen
    pure callback sv-image(float) -> image;
    // mancha de luz blanca (se colorea) y fondo del logo con su degradado, dibujados en Rust
    // luz: color, alfa máximo, radio, tipo de degradado y zona (x0, y0, ancho, alto) relativa al centro
    pure callback glow-image(color, float, float, int, float, float, float, float) -> image;
    pure callback logo-image(color, float) -> image;
    // engranaje de los ajustes girado ese ángulo (grados), como comandos de Path de 16×16
    pure callback gear-path(float) -> string;
    // pista de un deslizador (0 tono, 1 saturación, 2 luminosidad) para un color HSL
    pure callback track-image(int, float, float, float) -> image;
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px;
    min-width: txt.preferred-width + 28px;
    preferred-width: txt.preferred-width + 28px;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: !enabled ? Ui.p.raised : primary ? (ta.pressed ? Ui.p.accent.darker(0.08) : ta.has-hover ? Ui.p.accent.brighter(0.08) : Ui.p.accent) : (ta.has-hover ? Ui.p.raised : transparent);
    border-width: primary ? 0 : 1px;
    border-color: Ui.p.frame;
    animate background { duration: 100ms; }
    drop-shadow-blur: primary && enabled ? (ta.pressed ? 6px : ta.has-hover ? 18px : 0px) : 0px;
    drop-shadow-color: Ui.p.accent.with-alpha(0.45);
    animate drop-shadow-blur { duration: 220ms; easing: ease-out; }
    // al pulsar: un destello que se abre desde el centro y se desvanece
    flash := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: ta.pressed ? parent.width : 0px;
        height: parent.height;
        border-radius: root.border-radius;
        background: (primary ? #ffffff : Ui.p.text).with-alpha(ta.pressed ? 0.16 : 0);
        animate width { duration: ta.pressed ? 220ms : 0ms; easing: ease-out; }
        animate background { duration: 300ms; easing: ease-out; }
    }
    // centrado en un píxel entero: con la posición a medio píxel el texto blanco sobre el acento se veía disparejo
    txt := Text {
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        text: root.text;
        color: !enabled ? Ui.p.muted : primary ? Ui.p.on-accent : Ui.p.text;
        font-family: "Archivo Expanded";
        font-size: 12px;
        font-weight: 800;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Check inherits Rectangle {
    in property <bool> checked;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: checked ? 0px : 1px;
    border-color: Ui.p.muted;
    background: checked ? Ui.p.accent : transparent;
    // palomita dibujada (el carácter ✓ salía de una fuente de respaldo y se veía raro)
    if checked: Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: Ui.p.on-accent;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 4.2 8.3 L 6.9 10.9 L 11.9 5.4";
    }
}

component Switch inherits Rectangle {
    in property <bool> on;
    width: 30px;
    height: 18px;
    border-radius: 9px;
    background: on ? Ui.p.accent : Ui.p.raised;
    border-width: 1px;
    border-color: on ? Ui.p.accent : Ui.p.frame;
    Rectangle {
        x: on ? parent.width - self.width - 3px : 3px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: on ? Ui.p.on-accent : Ui.p.muted;
        animate x { duration: 150ms; easing: ease-out; }
    }
}

// Botones de la barra de título propia (minimizar, maximizar/restaurar, cerrar): pequeños y redondos,
// al estilo de GNOME; cerrar se pone rojo al pasar el ratón.
component WinBtn inherits Rectangle {
    in property <int> kind; // 0 minimizar, 1 maximizar, 2 cerrar
    in property <bool> maxed;
    callback clicked;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: ta.pressed ? (kind == 2 ? #c42b1c : Ui.p.frame.brighter(0.2)) : ta.has-hover ? (kind == 2 ? #e5484d : Ui.p.frame) : Ui.p.raised;
    animate background { duration: 90ms; }
    Path {
        width: 8px;
        height: 8px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: ta.has-hover && kind == 2 ? #ffffff : Ui.p.text.mix(Ui.p.muted, 0.35);
        stroke-width: 1.3px;
        fill: transparent;
        commands: kind == 0 ? "M 0 5.5 L 10 5.5" : kind == 2 ? "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5" : maxed ? "M 2.5 0.5 L 9.5 0.5 L 9.5 7.5 M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z" : "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z";
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Cap inherits Text {
    color: Ui.p.muted;
    font-family: "Archivo Expanded";
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
}

// Logo: gota (el tinte) con una mini timeline dentro: tres capas y el cabezal.
component Logo inherits Rectangle {
    in property <length> size: 36px;
    property <length> u: self.size / 32;
    width: size;
    height: size;
    border-radius: size * 0.28;
    Image {
        width: root.size;
        height: root.size;
        source: Ui.logo-image(Ui.p.accent, root.size / 1px);
        image-fit: fill;
    }
    Path {
        x: 0;
        y: 0;
        width: root.size;
        height: root.size;
        viewbox-width: 32;
        viewbox-height: 32;
        fill: white;
        commands: "M16 4.5 C16 4.5 8.5 12.6 8.5 18.3 A7.5 7.5 0 0 0 23.5 18.3 C23.5 12.6 16 4.5 16 4.5 Z";
    }
    for b in [{ x: 11.0, y: 15.6, w: 7.5 }, { x: 13.0, y: 18.6, w: 8.0 }, { x: 11.5, y: 21.6, w: 5.5 }]: Rectangle {
        x: root.u * b.x;
        y: root.u * b.y;
        width: root.u * b.w;
        height: root.u * 1.9;
        border-radius: root.u;
        background: Ui.p.base;
    }
    Rectangle { x: root.u * 17.4; y: root.u * 12.6; width: root.u * 1.2; height: root.u * 11.8; background: Ui.p.accent.darker(0.1); }
    Rectangle { x: root.u * 16.5; y: root.u * 11.4; width: root.u * 3; height: root.u * 2.2; border-radius: root.u * 0.7; background: Ui.p.accent.darker(0.1); }
}

// Deslizador de un canal (H, S o L): letra · pista con el degradado del canal · valor
component ChanSlider inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <image> track;
    // valor que se muestra y se escribe: 0..max (360 para el tono, 100 para S y L)
    in property <float> range: 100;
    in property <string> unit;
    // relleno del círculo: el color que da ese punto
    in property <color> knob: white;
    callback moved(float);
    height: 20px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            width: 10px;
            color: Ui.p.muted;
            font-family: "Archivo Expanded";
            font-size: 9.5px;
            font-weight: 800;
            vertical-alignment: center;
        }
        tr := Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 10px;
                border-radius: 5px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.track;
                    image-fit: fill;
                }
            }
            // esquinas redondeadas (ver el cuadro de color del selector); fuera del recorte para que se vea
            Rectangle {
                x: -5px;
                y: (parent.height - 10px) / 2 - 5px;
                width: parent.width + 10px;
                height: 20px;
                border-radius: 10px;
                border-width: 5px;
                border-color: Ui.p.panel;
            }
            Rectangle {
                x: root.value * (tr.width - self.width);
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 2px;
                border-color: white;
                background: root.knob;
                drop-shadow-blur: 3px;
                drop-shadow-color: #00000080;
            }
            TouchArea {
                mouse-cursor: pointer;
                function upd() { root.moved(max(0, min(1, (self.mouse-x - 7px) / (tr.width - 14px)))); }
                pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.upd(); } }
                moved => { if (self.pressed) { self.upd(); } }
            }
        }
        // recuadro para escribir el valor a mano
        Rectangle {
            width: 46px;
            border-radius: 5px;
            background: Ui.p.base;
            border-width: 1px;
            border-color: num.has-focus ? Ui.p.accent : Ui.p.frame;
            animate border-color { duration: 120ms; }
            num := TextInput {
                x: 6px;
                width: parent.width - 18px;
                vertical-alignment: center;
                horizontal-alignment: right;
                text: round(root.value * root.range);
                color: Ui.p.text;
                font-size: 10.5px;
                font-family: "JetBrains Mono";
                single-line: true;
                input-type: decimal;
                function commit() {
                    if (self.text.is-float()) {
                        root.moved(max(0, min(1, self.text.to-float() / root.range)));
                    }
                    self.text = round(root.value * root.range);
                }
                accepted => { self.commit(); self.clear-focus(); }
                changed has-focus => { if (!self.has-focus) { self.commit(); } }
                edited => { if (self.text.is-float() && self.text.to-float() >= 0 && self.text.to-float() <= root.range) { root.moved(self.text.to-float() / root.range); } }
            }
            Text {
                x: parent.width - 11px;
                text: root.unit;
                color: Ui.p.muted;
                font-size: 9px;
                vertical-alignment: center;
                height: parent.height;
            }
        }
    }
    // al arrastrar o cambiar desde fuera, el recuadro sigue al valor (si no se está escribiendo en él)
    changed value => { if (!num.has-focus) { num.text = round(root.value * root.range); } }
}

// Selector de color: el cuadro (saturación y brillo) y deslizadores de tono, saturación y luminosidad (HSL).
// El color de verdad se guarda en HSV (h, s, v); la saturación y luminosidad HSL se guardan aparte mientras se
// arrastran, para que llegar a negro o blanco no borre la saturación elegida.
component Picker inherits Rectangle {
    in-out property <float> h;
    in-out property <float> s;
    in-out property <float> v;
    property <float> sl;
    property <float> l;
    callback changed(string);
    width: 248px;
    height: 262px;

    pure function l-of(s: float, v: float) -> float { return v * (1 - s / 2); }
    pure function sl-of(s: float, v: float) -> float {
        return (l-of(s, v) <= 0.0001 || l-of(s, v) >= 0.9999) ? 0 : (v - l-of(s, v)) / min(l-of(s, v), 1 - l-of(s, v));
    }
    pure function v-of(sl: float, l: float) -> float { return l + sl * min(l, 1 - l); }
    pure function sv-of(sl: float, l: float) -> float { return v-of(sl, l) <= 0.0001 ? 0 : 2 * (1 - l / v-of(sl, l)); }
    pure function hsl(h: float, sl: float, l: float) -> color { return Ui.hsv-color(h, sv-of(sl, l), v-of(sl, l)); }
    function sync() {
        root.sl = sl-of(root.s, root.v);
        root.l = l-of(root.s, root.v);
    }
    function from-hsl() {
        root.s = sv-of(root.sl, root.l);
        root.v = v-of(root.sl, root.l);
        root.changed(Ui.hsv-hex(root.h, root.s, root.v));
    }
    property <bool> shown;
    init => {
        sync();
        appear.running = true;
    }
    appear := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            root.shown = true;
            self.running = false;
        }
    }

    Rectangle {
        opacity: root.shown ? 1 : 0;
        transform-scale: root.shown ? 1 : 0.94;
        animate opacity { duration: 160ms; easing: ease-out; }
        animate transform-scale { duration: 260ms; easing: ease-out-back; }
        background: Ui.p.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Ui.p.frame;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000080;

        sv := Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: 132px;
            Rectangle {
                border-radius: 8px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: Ui.sv-image(root.h);
                    image-fit: fill;
                }
            }
            // esquinas redondeadas: un marco del color del fondo encima (el renderizador por software no recorta
            // con radio); su borde interior coincide con el del cuadro
            Rectangle {
                x: -8px;
                y: -8px;
                width: parent.width + 16px;
                height: parent.height + 16px;
                border-radius: 16px;
                border-width: 8px;
                border-color: Ui.p.panel;
            }
            Rectangle {
                x: root.s * sv.width - 7px;
                y: (1 - root.v) * sv.height - 7px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 2px;
                border-color: white;
                background: Ui.hsv-color(root.h, root.s, root.v);
            }
            TouchArea {
                mouse-cursor: crosshair;
                function upd() {
                    root.s = max(0, min(1, self.mouse-x / sv.width));
                    root.v = max(0, min(1, 1 - self.mouse-y / sv.height));
                    sync();
                    root.changed(Ui.hsv-hex(root.h, root.s, root.v));
                }
                pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.upd(); } }
                moved => { if (self.pressed) { self.upd(); } }
            }
        }

        VerticalLayout {
            x: 12px;
            y: 156px;
            width: parent.width - 24px;
            height: 70px;
            spacing: 8px;
            ChanSlider {
                label: "H";
                value: root.h;
                range: 360;
                unit: "°";
                knob: Ui.hsv-color(root.h, 1, 1);
                track: Ui.track-image(0, root.h, root.sl, root.l);
                moved(x) => {
                    root.h = min(0.999, x);
                    root.changed(Ui.hsv-hex(root.h, root.s, root.v));
                }
            }
            ChanSlider {
                label: "S";
                value: root.sl;
                unit: "%";
                knob: Ui.hsv-color(root.h, root.s, root.v);
                track: Ui.track-image(1, root.h, root.sl, root.l);
                moved(x) => {
                    root.sl = x;
                    from-hsl();
                }
            }
            ChanSlider {
                label: "L";
                value: root.l;
                unit: "%";
                knob: Ui.hsv-color(root.h, root.s, root.v);
                track: Ui.track-image(2, root.h, root.sl, root.l);
                moved(x) => {
                    root.l = x;
                    from-hsl();
                }
            }
        }

        HorizontalLayout {
            x: 12px;
            y: 234px;
            width: parent.width - 24px;
            height: 16px;
            spacing: 8px;
            Rectangle {
                width: 16px;
                border-radius: 4px;
                background: Ui.hsv-color(root.h, root.s, root.v);
                border-width: 1px;
                border-color: Ui.p.frame;
            }
            Text {
                text: Ui.hsv-hex(root.h, root.s, root.v);
                color: Ui.p.muted;
                font-size: 11px;
                font-family: "Consolas";
                vertical-alignment: center;
            }
        }
    }
}

// Fila de la paleta: muestra · nombre · hex
component ColorRow inherits Rectangle {
    in property <ColorEntry> entry;
    callback changed(string);
    property <float> ph;
    property <float> ps;
    property <float> pv;
    height: 36px;
    border-radius: 6px;
    background: ta-row.has-hover ? Ui.p.raised.with-alpha(0.6) : transparent;
    ta-row := TouchArea { }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 5px;
                background: root.entry.value;
                border-width: 1px;
                border-color: Ui.p.frame;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.ph = Ui.hex-hsv(root.entry.hex).h;
                        root.ps = Ui.hex-hsv(root.entry.hex).s;
                        root.pv = Ui.hex-hsv(root.entry.hex).v;
                        popup.show();
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.entry.label; color: Ui.p.text; font-size: 12px; font-weight: 500; }
            Text { text: root.entry.hint; color: Ui.p.muted; font-size: 10.5px; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 76px;
                height: 24px;
                border-radius: 5px;
                background: Ui.p.raised;
                border-width: 1px;
                border-color: hex.has-focus ? Ui.p.accent : Ui.p.frame;
                hex := TextInput {
                    x: 9px;
                    width: parent.width - 18px;
                    vertical-alignment: center;
                    text: root.entry.hex;
                    color: Ui.p.text;
                    font-size: 11.5px;
                    font-family: "JetBrains Mono";
                    single-line: true;
                    accepted => { root.changed(self.text); }
                    edited => { if (self.text.character-count == 7) { root.changed(self.text); } }
                }
            }
        }
    }

    popup := PopupWindow {
        x: -258px;
        y: -110px;
        width: 248px;
        height: 262px;
        close-policy: close-on-click-outside;
        Picker {
            h <=> root.ph;
            s <=> root.ps;
            v <=> root.pv;
            changed(hx) => { root.changed(hx); }
        }
    }
}

// Fila de la timeline en el inspector: muestra · nombre · valor · casilla. Sin marcar sigue la paleta.
component TlRow inherits Rectangle {
    in property <ColorEntry> entry;
    callback changed(string);
    callback toggled(bool);
    property <float> ph;
    property <float> ps;
    property <float> pv;
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover ? Ui.p.raised.with-alpha(0.6) : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.entry.custom); }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 5px;
                background: root.entry.value;
                border-width: 1px;
                border-color: Ui.p.frame;
                opacity: root.entry.custom ? 1 : 0.6;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (!root.entry.custom) { root.toggled(true); }
                        root.ph = Ui.hex-hsv(root.entry.hex).h;
                        root.ps = Ui.hex-hsv(root.entry.hex).s;
                        root.pv = Ui.hex-hsv(root.entry.hex).v;
                        popup.show();
                    }
                }
            }
        }
        Text {
            text: root.entry.label;
            color: Ui.p.text;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.entry.custom ? root.entry.hex : Ui.t("Auto", "Auto");
            color: Ui.p.muted;
            font-size: 11px;
            font-family: root.entry.custom ? "JetBrains Mono" : "Inter";
            vertical-alignment: center;
        }
        VerticalLayout { alignment: center; Check { checked: root.entry.custom; } }
    }
    popup := PopupWindow {
        x: -258px;
        y: -120px;
        width: 248px;
        height: 262px;
        close-policy: close-on-click-outside;
        Picker {
            h <=> root.ph;
            s <=> root.ps;
            v <=> root.pv;
            changed(hx) => { root.changed(hx); }
        }
    }
}

// Miniatura de un tema: un trozo de AE con sus colores y el nombre.
component ThemeTile inherits Rectangle {
    in property <PresetItem> pr;
    in property <bool> deletable: false;
    callback picked;
    callback deleted;
    callback exported;
    height: 64px;
    border-radius: 8px;
    background: pr.base;
    border-width: 1px;
    border-color: ta.has-hover ? pr.text.with-alpha(0.45) : pr.panel.mix(pr.text, 0.85);
    animate border-color { duration: 100ms; }
    clip: true;
    // mini pop: se hunde al pulsar y rebota al soltar; sube un poco al pasar el ratón
    transform-scale: ta.pressed ? 0.94 : 1;
    animate transform-scale { duration: 340ms; easing: ease-out-back; }
    // panel con una línea de texto y una barra de acento
    Rectangle {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: 22px;
        border-radius: 4px;
        background: root.pr.panel;
        Rectangle { x: 7px; y: 6px; width: parent.width * 0.42; height: 3px; border-radius: 1.5px; background: root.pr.text.with-alpha(0.7); }
        Rectangle { x: 7px; y: 13px; width: parent.width * 0.24; height: 3px; border-radius: 1.5px; background: root.pr.accent; }
        Rectangle { x: parent.width - 17px; y: 5px; width: 11px; height: 11px; border-radius: 3px; background: root.pr.raised; }
    }
    // el nombre completo: si no cabe en una línea, pasa a dos
    Text {
        x: 8px;
        y: 31px;
        width: parent.width - 16px;
        height: parent.height - 35px;
        text: root.pr.name;
        color: root.pr.text;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    // exportar como .aetint (flecha hacia abajo)
    if root.deletable: Rectangle {
        visible: ta.has-hover || eta.has-hover;
        x: parent.width - 48px;
        y: 4px;
        width: 20px;
        height: 20px;
        border-radius: 5px;
        background: eta.has-hover ? root.pr.accent : root.pr.panel;
        Path {
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            stroke: eta.has-hover ? root.pr.base : root.pr.text;
            stroke-width: 1.4px;
            fill: transparent;
            commands: "M 5 1 L 5 6.5 M 2.5 4.2 L 5 6.7 L 7.5 4.2 M 1.5 9 L 8.5 9";
        }
        eta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.exported(); }
        }
    }
    if root.deletable: Rectangle {
        visible: ta.has-hover || dta.has-hover;
        x: parent.width - 24px;
        y: 4px;
        width: 20px;
        height: 20px;
        border-radius: 5px;
        background: dta.has-hover ? #f38ba8 : root.pr.panel;
        Text { text: "×"; color: dta.has-hover ? #1e1e2e : root.pr.text; font-size: 14px; }
        dta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.deleted(); }
        }
    }
}

// Fila de ajuste con interruptor (menú de ajustes).
component OptRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled;
    height: 34px;
    border-radius: 6px;
    opacity: enabled ? 1 : 0.45;
    background: ta.has-hover && enabled ? Ui.p.raised : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        Text {
            text: root.label;
            color: Ui.p.text;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout { alignment: center; Switch { on: root.on; } }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Botón segmentado discreto (Dark/Light, Presets/My themes, EN/ES): la opción elegida en un tono más claro.
component Seg inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    callback picked(int);
    // posición de la pastilla: la toma de la opción elegida (cada opción la avisa al cambiar)
    property <length> px;
    property <length> pw;
    property <bool> placed;
    height: 26px;
    border-radius: 7px;
    background: Ui.p.base;
    border-width: 1px;
    border-color: Ui.p.frame;
    // pastilla deslizante
    Rectangle {
        x: root.px;
        y: 2px;
        width: root.pw;
        height: parent.height - 4px;
        border-radius: 5px;
        background: Ui.p.frame;
        animate x, width { duration: root.placed ? 260ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1.08); }
    }
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for it[k] in root.items: Rectangle {
            property <bool> sel: k == root.current;
            function place() {
                if (self.sel && self.width > 0) {
                    root.px = self.x;
                    root.pw = self.width;
                    root.placed = true;
                }
            }
            changed sel => { self.place(); }
            changed x => { self.place(); }
            changed width => { self.place(); }
            init => { self.place(); }
            border-radius: 5px;
            background: !self.sel && sta.has-hover ? Ui.p.raised.with-alpha(0.6) : transparent;
            min-width: lbl.preferred-width + 20px;
            animate background { duration: 100ms; }
            lbl := Text {
                text: it;
                color: k == root.current ? Ui.p.text : Ui.p.muted;
                font-family: "Archivo Expanded";
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 1px;
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => { if (k != root.current) { root.picked(k); } }
            }
        }
    }
}

// Flechas ‹ › y fundidos en los bordes de una fila de temas que se desplaza.
component RowArrows inherits Rectangle {
    in-out property <length> pos;
    in property <length> content;
    property <length> min-pos: min(0px, root.width - root.content);
    // animación del desplazamiento: de `from` a `to` en 24 pasos de 15 ms (≈360 ms) con ease-out
    property <length> from;
    property <length> to;
    property <int> n;
    property <bool> moving: false;
    public function go(target: length) {
        root.from = root.pos;
        root.to = max(root.min-pos, min(0px, target));
        root.n = 0;
        root.moving = true;
    }
    // suma al destino actual (varios clics o pasos de rueda seguidos se acumulan)
    public function nudge(d: length) {
        root.go((root.moving ? root.to : root.pos) + d);
    }
    function step() {
        root.n += 1;
        if (root.n >= 24) {
            root.pos = root.to;
            root.moving = false;
        } else {
            root.pos = root.from + (root.to - root.from) * (1 - pow(1 - root.n / 24, 3));
        }
    }
    Timer {
        interval: 15ms;
        running: root.moving;
        triggered => { root.step(); }
    }
    property <bool> can-left: root.pos < -1px;
    property <bool> can-right: root.pos > root.min-pos + 1px;
    // fundidos
    Rectangle {
        x: 0;
        width: 44px;
        opacity: root.can-left ? 1 : 0;
        animate opacity { duration: 160ms; }
        background: @linear-gradient(90deg, Ui.p.base 0%, Ui.p.base.with-alpha(0) 100%);
    }
    Rectangle {
        x: parent.width - self.width;
        width: 44px;
        opacity: root.can-right ? 1 : 0;
        animate opacity { duration: 160ms; }
        background: @linear-gradient(270deg, Ui.p.base 0%, Ui.p.base.with-alpha(0) 100%);
    }
    for side in [0, 1]: Rectangle {
        property <bool> on: side == 0 ? root.can-left : root.can-right;
        x: side == 0 ? 4px : parent.width - self.width - 4px;
        y: (parent.height - self.height) / 2;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: ata.has-hover ? Ui.p.frame : Ui.p.panel;
        border-width: 1px;
        border-color: Ui.p.frame;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000060;
        opacity: self.on ? 1 : 0;
        visible: self.opacity > 0.01;
        transform-scale: ata.pressed ? 0.9 : 1;
        animate opacity { duration: 160ms; }
        animate transform-scale { duration: 220ms; easing: ease-out-back; }
        Path {
            width: 8px;
            height: 10px;
            viewbox-width: 8;
            viewbox-height: 10;
            stroke: Ui.p.text;
            stroke-width: 1.6px;
            fill: transparent;
            commands: side == 0 ? "M 6 1 L 2 5 L 6 9" : "M 2 1 L 6 5 L 2 9";
        }
        ata := TouchArea {
            enabled: parent.on;
            mouse-cursor: pointer;
            clicked => { root.nudge((side == 0 ? 1 : -1) * 3 * 136px); }
        }
    }
}

// Separador fino del inspector
component Hairline inherits Rectangle {
    height: 1px;
    background: Ui.p.frame;
}

// Maqueta de After Effects con los colores que se van a escribir.
component AePreview inherits Rectangle {
    // pintar la barra de menús y el título de AE: el interruptor está sobre la propia barra de la vista previa
    in property <bool> menus;
    callback toggle-menus;
    border-radius: 12px;
    clip: true;
    background: Ui.p.base;
    border-width: 1px;
    border-color: Ui.p.frame;

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        // menú + barra de herramientas
        Rectangle {
            height: 30px;
            border-radius: 6px;
            // apagado: la barra como la deja Windows
            background: root.menus ? Ui.p.frame : #2b2b2b;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 14px;
                for m in ["File", "Edit", "Composition", "Layer", "Effect", "Animation", "View", "Window", "Help"]: Text {
                    text: m;
                    color: root.menus ? Ui.p.text : #ffffff;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: tint-row.preferred-width;
                    border-radius: 5px;
                    tint-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 8px;
                        Text {
                            text: Ui.t("TINT MENU & TITLE", "TINTAR MENÚ Y TÍTULO");
                            color: tint-ta.has-hover ? (root.menus ? Ui.p.text : #ffffff) : (root.menus ? Ui.p.muted : #b0b0b0);
                            font-family: "Archivo Expanded";
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }
                        VerticalLayout { alignment: center; Switch { on: root.menus; } }
                    }
                    tint-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-menus(); }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 1;
            // proyecto
            Rectangle {
                width: 22%;
                border-radius: 6px;
                background: Ui.p.panel;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    alignment: start;
                    Text { text: "Project"; color: Ui.p.text; font-size: 11px; font-weight: 600; }
                    Rectangle { height: 20px; border-radius: 5px; background: Ui.p.raised; }
                    for i in 4: Rectangle {
                        height: 14px;
                        border-radius: 3px;
                        background: i == 1 ? Ui.p.accent.with-alpha(0.35) : transparent;
                        Text { x: 6px; text: "Comp " + (i + 1); color: Ui.p.muted; font-size: 10px; }
                    }
                }
            }
            // visor
            Rectangle {
                border-radius: 6px;
                background: Ui.p.panel;
                Rectangle {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    border-radius: 4px;
                    background: Ui.p.raised;
                    Rectangle {
                        width: 46%;
                        height: 56%;
                        background: #000;
                        border-width: 1px;
                        border-color: Ui.p.frame;
                    }
                }
            }
            // efectos
            Rectangle {
                width: 20%;
                border-radius: 6px;
                background: Ui.p.panel;
                VerticalLayout {
                    padding: 8px;
                    spacing: 5px;
                    alignment: start;
                    Text { text: "Effects & Presets"; color: Ui.p.text; font-size: 11px; font-weight: 600; }
                    for i in 5: Text { text: "› Category " + (i + 1); color: Ui.p.muted; font-size: 10px; }
                }
            }
        }
        // timeline
        Rectangle {
            height: 46%;
            border-radius: 6px;
            background: Ui.p.panel;
            HorizontalLayout {
                // columnas de capas
                Rectangle {
                    width: 38%;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 0px;
                        alignment: start;
                        Rectangle { height: 22px; Text { x: 4px; text: "0:00:00:00"; color: Ui.p.accent; font-size: 12px; font-weight: 600; } }
                        Rectangle { height: 18px; Text { x: 4px; text: "Source Name"; color: Ui.p.muted; font-size: 10px; } }
                        for i in 3: Rectangle {
                            height: 20px;
                            background: i == 0 ? Ui.p.frame : transparent;
                            Text { x: 6px; text: (i + 1) + "   Layer " + (i + 1); color: Ui.p.text; font-size: 10px; }
                        }
                    }
                }
                // área de tiempo
                Rectangle {
                    background: Ui.p.tl-bg;
                    border-top-right-radius: 6px;
                    border-bottom-right-radius: 6px;
                    clip: true;
                    // navegador de tiempo
                    Rectangle {
                        y: 4px;
                        x: 6px;
                        width: parent.width - 12px;
                        height: 8px;
                        border-radius: 2px;
                        background: Ui.p.nav;
                    }
                    // regla
                    Rectangle {
                        y: 16px;
                        height: 24px;
                        background: Ui.p.ruler;
                        Rectangle { y: parent.height - 1px; height: 1px; background: Ui.p.ruler-border; }
                        for i in 12: Rectangle {
                            x: (i + 0.5) * parent.width / 12;
                            y: parent.height - 7px;
                            width: 1px;
                            height: 6px;
                            background: Ui.p.muted;
                        }
                    }
                    // área de trabajo
                    Rectangle {
                        y: 40px;
                        x: 6px;
                        width: parent.width * 0.7;
                        height: 6px;
                        background: Ui.p.work;
                        border-width: 1px;
                        border-color: Ui.p.work-edge;
                    }
                    // barras de capa
                    for i in 3: Rectangle {
                        x: 6px + i * 14px;
                        y: 52px + i * 20px;
                        width: parent.width * (0.82 - i * 0.12);
                        height: 16px;
                        border-radius: 2px;
                        background: i == 0 ? Ui.p.layer-sel : Ui.p.layer;
                        Text {
                            x: parent.width * 0.3;
                            text: "◆";
                            font-size: 11px;
                            color: i == 0 ? Ui.p.key-sel : Ui.p.muted;
                        }
                    }
                    // líneas de cuadrícula
                    for i in 4: Rectangle {
                        y: 70px + i * 20px;
                        height: 1px;
                        background: Ui.p.grid;
                    }
                    // CTI
                    Rectangle {
                        x: parent.width * 0.42;
                        y: 14px;
                        width: 1px;
                        height: parent.height;
                        background: Ui.p.cti;
                        Rectangle { y: 0; x: -5px; width: 11px; height: 10px; border-radius: 2px; background: Ui.p.cti; }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "AeTint";
    no-frame: true;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 1100px;
    min-height: 780px;
    background: Ui.p.base;
    default-font-family: "Inter";

    in property <[TargetItem]> targets;
    in property <[PresetItem]> presets;
    in property <[ColorEntry]> palette;
    in property <[ColorEntry]> timeline;
    in property <string> status;
    in property <bool> status-error;
    in property <bool> status-ok;
    // botón junto al aviso: "Apply" con cambios sin aplicar, "Retry" tras un error ("" = sin botón)
    in property <string> status-action;
    callback status-act();
    // un error se pulsa para abrir el registro completo (aetint.log)
    callback open-log();
    in property <bool> busy;
    in property <bool> is-max;
    // destello breve del aviso cuando cambia el mensaje
    property <float> flash: 0;
    property <color> status-color: root.status-error ? #f38ba8 : root.busy ? #f9e2af : root.status-ok ? #a6e3a1 : Ui.p.accent;
    changed status => {
        root.flash = 1;
        flash-timer.running = true;
    }
    flash-timer := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            root.flash = 0;
            self.running = false;
        }
    }
    in-out property <bool> menus;
    in-out property <bool> autostart;
    in-out property <bool> watcher;
    in-out property <bool> sounds: true;
    callback toggle-sounds(bool);

    callback toggle-target(string, bool);
    callback set-palette(string, string);
    callback set-override(string, string);
    callback toggle-override(string, bool);
    callback use-preset(int);
    callback apply();
    callback restore();
    callback rescan();
    callback toggle-menus(bool);
    callback toggle-autostart(bool);
    callback toggle-watcher(bool);
    callback set-lang(bool);
    // temas guardados por el usuario
    in property <[PresetItem]> themes;
    callback save-theme(string);
    callback apply-theme(int);
    callback delete-theme(int);
    // brillo que se edita: oscuro (Darkest y Dark de AE) o claro (Light)
    in property <bool> edit-light;
    callback set-edit-light(bool);
    // versión actual y, si hay una más nueva en GitHub, su número
    in property <string> app-version;
    in property <string> update-version;
    // descarga de la actualización en curso (0..1)
    in property <bool> update-busy;
    in property <float> update-progress;
    callback open-update();
    in-out property <int> lib-tab: 0;
    property <angle> gear-rot: 0deg;
    animate gear-rot { duration: 520ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1.1); }
    // al cambiar de pestaña (presets / mis temas) los temas entran con un fundido y un pequeño pop
    property <bool> lib-in: true;
    changed lib-tab => {
        root.lib-in = false;
        lib-timer.running = true;
    }
    lib-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            root.lib-in = true;
            self.running = false;
        }
    }
    // temas en archivos .aetint
    callback import-theme();
    callback export-theme(int);
    // pantalla de inicio propia ("" = la de Adobe)
    in property <string> splash-name;
    in property <image> splash-thumb;
    callback choose-splash();
    callback clear-splash();
    callback start-drag();
    callback start-resize(int);
    callback win-minimize();
    callback win-maximize();
    callback win-close();

    // fuga de luz que sale del logo (centro en 31,26), animada despacio: el halo deriva y respira, el núcleo late
    // y un reflejo más claro recorre la cabecera. Todo con el acento del tema.
    // tiempo de la luz (segundos): lo avanza Rust a ~30 fps y se pausa sin foco o minimizada,
    // así no obliga a redibujar la ventana a 60 fps todo el rato
    in property <float> lt;
    // (manchas ya coloreadas y con tramado, generadas en Rust: solo la zona que se puede ver de cada una; el
    // pulso de intensidad va en la opacidad)
    // halo alrededor del logo (radio 540, visible hasta el 70 %)
    Image {
        x: 31px + 34px * Math.sin(root.lt * 19deg) - 70px;
        y: 26px + 24px * Math.cos(root.lt * 14deg) - 60px;
        width: 448px;
        height: 438px;
        source: Ui.glow-image(Ui.p.accent, 0.165, 540, 0, -70, -60, 448, 438);
        image-fit: fill;
        opacity: (0.13 + 0.035 * Math.sin(root.lt * 31deg)) / 0.165;
    }
    // reflejo más claro que recorre la cabecera (radio 280)
    Image {
        x: 300px + 150px * Math.sin(root.lt * 11deg) - 196px;
        y: 8px + 26px * Math.cos(root.lt * 17deg) - 196px;
        width: 392px;
        height: 392px;
        source: Ui.glow-image(Ui.p.accent.mix(#ffffff, 0.75), 0.075, 280, 1, -196, -196, 392, 392);
        image-fit: fill;
        opacity: (0.05 + 0.025 * Math.sin(root.lt * 23deg + 90deg)) / 0.075;
    }
    // núcleo que late sobre el logo (radio 160)
    Image {
        x: 31px - 112px;
        y: 26px - 112px;
        width: 224px;
        height: 224px;
        source: Ui.glow-image(Ui.p.accent.mix(#ffffff, 0.8), 0.26, 160, 2, -112, -112, 224, 224);
        image-fit: fill;
        opacity: (0.20 + 0.06 * Math.sin(root.lt * 57deg)) / 0.26;
    }

    // barra de título propia: se arrastra y con doble clic se maximiza
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 52px;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.start-drag(); }
            }
            double-clicked => { root.win-maximize(); }
        }
    }

    VerticalLayout {
        // ── cabecera
        HorizontalLayout {
            height: 52px;
            padding-left: 16px;
            // sitio para los botones de ventana (y la línea que los separa del engranaje)
            padding-right: 112px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                // sombra del logo: halo del acento + sombra oscura (el logo recorta su contenido, la sombra va aparte)
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 30px * 0.28;
                    background: Ui.p.accent;
                    drop-shadow-blur: 18px;
                    drop-shadow-color: Ui.p.accent.with-alpha(0.55);
                    Rectangle {
                        border-radius: 30px * 0.28;
                        background: Ui.p.accent;
                        drop-shadow-blur: 6px;
                        drop-shadow-offset-y: 3px;
                        drop-shadow-color: #00000090;
                        Logo { size: 30px; }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "AeTint";
                    color: Ui.p.text;
                    font-family: "Archivo Expanded";
                    font-size: 17px;
                    font-weight: 800;
                }
            }
            // versión actual, o aviso de actualización (pulsar descarga e instala)
            VerticalLayout {
                alignment: center;
                if root.update-version == "": Text {
                    text: "v" + root.app-version;
                    color: Ui.p.muted;
                    font-family: "JetBrains Mono";
                    font-size: 10.5px;
                }
                if root.update-version != "": Rectangle {
                    height: 22px;
                    width: upd-row.preferred-width + 18px;
                    border-radius: 6px;
                    background: upd-ta.has-hover && !root.update-busy ? Ui.p.accent.brighter(0.08) : Ui.p.accent;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: root.update-busy ? parent.width * root.update-progress : 0;
                        background: Ui.p.on-accent.with-alpha(0.22);
                        animate width { duration: 150ms; }
                    }
                    upd-row := HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Ui.p.on-accent;
                                opacity: 0.45 + 0.55 * Math.abs(Math.sin(animation-tick() / 6ms * 1deg));
                            }
                        }
                        Text {
                            text: !root.update-busy ? Ui.t("Update to", "Actualizar a") + " v" + root.update-version
                                : root.update-progress < 1 ? Ui.t("Downloading", "Descargando") + " " + Math.round(root.update-progress * 100) + "%"
                                : Ui.t("Installing…", "Instalando…");
                            color: Ui.p.on-accent;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    upd-ta := TouchArea {
                        mouse-cursor: root.update-busy ? default : pointer;
                        clicked => { root.open-update(); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // ajustes: inicio con Windows, sonido e idioma
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 7px;
                    background: gear-ta.has-hover ? Ui.p.raised : transparent;
                    // engranaje: gira al abrir los ajustes
                    Path {
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        fill: gear-ta.has-hover ? Ui.p.text : Ui.p.text.mix(Ui.p.muted, 0.45);
                        fill-rule: evenodd;
                        // la forma ya girada se calcula en Rust: el renderizador por software no gira elementos
                        commands: Ui.gear-path(root.gear-rot / 1deg);
                    }
                    gear-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.gear-rot += 120deg;
                            settings.show();
                        }
                    }
                    settings := PopupWindow {
                        x: parent.width - 300px;
                        y: parent.height + 6px;
                        width: 300px;
                        close-policy: close-on-click-outside;
                        Rectangle {
                            property <bool> shown;
                            init => { set-appear.running = true; }
                            set-appear := Timer {
                                interval: 16ms;
                                running: false;
                                triggered => {
                                    parent.shown = true;
                                    self.running = false;
                                }
                            }
                            opacity: self.shown ? 1 : 0;
                            transform-origin: { x: self.width - 16px, y: 0px };
                            transform-scale: self.shown ? 1 : 0.92;
                            animate opacity { duration: 170ms; easing: ease-out; }
                            animate transform-scale { duration: 300ms; easing: ease-out-back; }
                            background: Ui.p.panel;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Ui.p.frame;
                            drop-shadow-blur: 20px;
                            drop-shadow-color: #00000070;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                // misma sangría que las filas (en un layout la x no se aplica)
                                HorizontalLayout {
                                    padding-left: 10px;
                                    Text { text: Ui.t("SETTINGS", "AJUSTES"); color: Ui.p.muted; font-family: "Archivo Expanded"; font-size: 11px; font-weight: 800; letter-spacing: 1px; height: 24px; vertical-alignment: center; }
                                }
                                OptRow {
                                    label: Ui.t("Watchdog for AE without the plugin", "Vigilante para AE sin el plugin");
                                    on: root.watcher;
                                    enabled: root.menus;
                                    toggled => { root.toggle-watcher(!root.watcher); }
                                }
                                OptRow {
                                    label: Ui.t("Start the watchdog with Windows", "Iniciar el vigilante con Windows");
                                    on: root.autostart;
                                    enabled: root.menus && root.watcher;
                                    toggled => { root.toggle-autostart(!root.autostart); }
                                }
                                OptRow {
                                    label: Ui.t("Sound when it's done or fails", "Sonido al terminar o si falla");
                                    on: root.sounds;
                                    toggled => { root.toggle-sounds(!root.sounds); }
                                }
                                Rectangle {
                                    height: 34px;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        Text { text: Ui.t("Language", "Idioma"); color: Ui.p.text; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                        VerticalLayout {
                                            alignment: center;
                                            Seg {
                                                items: ["ENGLISH", "ESPAÑOL"];
                                                current: Ui.es ? 1 : 0;
                                                picked(k) => { root.set-lang(k == 1); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;

            // ── zona de trabajo: vista previa y temas
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 16px;
                spacing: 14px;
                AePreview {
                    vertical-stretch: 1;
                    min-height: 250px;
                    menus: root.menus;
                    toggle-menus => { root.toggle-menus(!root.menus); }
                }

                HorizontalLayout {
                    spacing: 12px;
                    height: 26px;
                    Seg {
                        items: [Ui.t("PRESETS", "PRESETS"), Ui.t("MY THEMES", "MIS TEMAS") + (root.themes.length > 0 ? " · " + root.themes.length : "")];
                        current: root.lib-tab;
                        picked(k) => { root.lib-tab = k; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // guardar los colores actuales como tema propio
                    if root.lib-tab == 1: HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 220px;
                            border-radius: 7px;
                            background: Ui.p.base;
                            border-width: 1px;
                            border-color: tname.has-focus ? Ui.p.accent : Ui.p.frame;
                            tname := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                vertical-alignment: center;
                                color: Ui.p.text;
                                font-size: 12px;
                                single-line: true;
                                accepted => {
                                    if (self.text != "") {
                                        root.save-theme(self.text);
                                        self.text = "";
                                    }
                                }
                            }
                            Text {
                                x: 10px;
                                visible: tname.text == "";
                                text: Ui.t("Name your colours…", "Ponle nombre a tus colores…");
                                color: Ui.p.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                                height: parent.height;
                            }
                        }
                        Rectangle {
                            width: 64px;
                            border-radius: 7px;
                            background: sva.has-hover && tname.text != "" ? Ui.p.raised : transparent;
                            border-width: 1px;
                            border-color: Ui.p.frame;
                            Text { text: Ui.t("Save", "Guardar"); color: tname.text == "" ? Ui.p.muted : Ui.p.text; font-family: "Archivo Expanded"; font-size: 10.5px; font-weight: 800; }
                            sva := TouchArea {
                                enabled: tname.text != "";
                                mouse-cursor: pointer;
                                clicked => {
                                    root.save-theme(tname.text);
                                    tname.text = "";
                                }
                            }
                        }
                        // abrir un .aetint
                        Rectangle {
                            width: imp-lbl.preferred-width + 22px;
                            border-radius: 7px;
                            background: ita.has-hover ? Ui.p.raised : transparent;
                            border-width: 1px;
                            border-color: Ui.p.frame;
                            imp-lbl := Text { text: Ui.t("Import…", "Importar…"); color: Ui.p.text; font-family: "Archivo Expanded"; font-size: 10.5px; font-weight: 800; }
                            ita := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.import-theme(); }
                            }
                        }
                    }
                    // pantalla de inicio propia: a la derecha, siempre a mano
                    Rectangle {
                        width: sp-row.preferred-width;
                        border-radius: 7px;
                        background: sp-ta.has-hover ? Ui.p.raised : transparent;
                        border-width: 1px;
                        border-color: root.splash-name != "" ? Ui.p.accent.with-alpha(0.6) : Ui.p.frame;
                        sp-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.choose-splash(); }
                        }
                        sp-row := HorizontalLayout {
                            // con la × el margen derecho es el mismo que arriba y abajo
                            padding-left: 10px;
                            padding-right: root.splash-name != "" ? 4px : 10px;
                            spacing: 7px;
                            if root.splash-name != "": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 26px;
                                    height: 16px;
                                    border-radius: 3px;
                                    clip: true;
                                    Image { width: 26px; height: 16px; source: root.splash-thumb; image-fit: cover; }
                                }
                            }
                            if root.splash-name == "": VerticalLayout {
                                alignment: center;
                                // icono de imagen
                                Path {
                                    width: 13px;
                                    height: 11px;
                                    viewbox-width: 13;
                                    viewbox-height: 11;
                                    stroke: Ui.p.muted;
                                    stroke-width: 1.2px;
                                    fill: transparent;
                                    commands: "M 1 1 L 12 1 L 12 10 L 1 10 Z M 1.5 8.5 L 5 5 L 7.5 7.5 L 9 6 L 11.5 8.5";
                                }
                            }
                            Text {
                                text: Ui.t("SPLASH", "INICIO") + " · " + (root.splash-name == "" ? Ui.t("ADOBE'S", "ADOBE") : Ui.t("YOURS", "TUYO"));
                                color: root.splash-name == "" ? Ui.p.muted : Ui.p.text;
                                font-family: "Archivo Expanded";
                                font-size: 10px;
                                font-weight: 800;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                            if root.splash-name != "": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 5px;
                                    background: cs-ta.has-hover ? Ui.p.frame : transparent;
                                    // X dibujada: centrada de verdad (el carácter "×" queda desplazado)
                                    Path {
                                        width: 8px;
                                        height: 8px;
                                        viewbox-width: 8;
                                        viewbox-height: 8;
                                        stroke: cs-ta.has-hover ? Ui.p.text : Ui.p.muted;
                                        stroke-width: 1.3px;
                                        fill: transparent;
                                        commands: "M 0.5 0.5 L 7.5 7.5 M 7.5 0.5 L 0.5 7.5";
                                    }
                                    cs-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.clear-splash(); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.lib-tab == 0: Rectangle {
                    opacity: root.lib-in ? 1 : 0;
                    transform-scale: root.lib-in ? 1 : 0.97;
                    animate opacity { duration: root.lib-in ? 240ms : 0ms; easing: ease-out; }
                    animate transform-scale { duration: root.lib-in ? 320ms : 0ms; easing: ease-out-back; }
                    height: 72px;
                    pf := Flickable {
                        height: 72px;
                        content-width: root.presets.length * 136px - 8px;
                        TouchArea {
                            width: max(pf.width, pf.content-width);
                            height: 72px;
                            scroll-event(e) => {
                                pf-arrows.nudge((e.delta-y + e.delta-x) * 1.5);
                                return accept;
                            }
                            for pr[i] in root.presets: ThemeTile {
                                x: i * 136px;
                                y: 4px;
                                width: 128px;
                                pr: pr;
                                picked => { root.use-preset(i); }
                            }
                        }
                    }
                    pf-arrows := RowArrows {
                        pos <=> pf.content-x;
                        content: pf.content-width;
                    }
                }
                if root.lib-tab == 1 && root.themes.length == 0: Rectangle {
                    opacity: root.lib-in ? 1 : 0;
                    transform-scale: root.lib-in ? 1 : 0.97;
                    animate opacity { duration: root.lib-in ? 240ms : 0ms; easing: ease-out; }
                    animate transform-scale { duration: root.lib-in ? 320ms : 0ms; easing: ease-out-back; }
                    height: 72px;
                    // mismo alto que una fila de temas (al cambiar de pestaña no se mueve nada)
                    Rectangle {
                        y: 4px;
                        height: 64px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Ui.p.frame;
                    }
                    Text {
                        text: Ui.t("No saved themes yet. Adjust your colours, name them above and press Save.", "Aún no hay temas guardados. Ajusta tus colores, ponles nombre arriba y pulsa Guardar.");
                        color: Ui.p.muted;
                        font-size: 11.5px;
                    }
                }
                if root.lib-tab == 1 && root.themes.length > 0: Rectangle {
                    opacity: root.lib-in ? 1 : 0;
                    transform-scale: root.lib-in ? 1 : 0.97;
                    animate opacity { duration: root.lib-in ? 240ms : 0ms; easing: ease-out; }
                    animate transform-scale { duration: root.lib-in ? 320ms : 0ms; easing: ease-out-back; }
                    height: 72px;
                    tf := Flickable {
                        height: 72px;
                        content-width: root.themes.length * 136px - 8px;
                        TouchArea {
                            width: max(tf.width, tf.content-width);
                            height: 72px;
                            scroll-event(e) => {
                                tf-arrows.nudge((e.delta-y + e.delta-x) * 1.5);
                                return accept;
                            }
                            for th[i] in root.themes: ThemeTile {
                                x: i * 136px;
                                y: 4px;
                                width: 128px;
                                pr: th;
                                deletable: true;
                                picked => { root.apply-theme(i); }
                                deleted => { root.delete-theme(i); }
                                exported => { root.export-theme(i); }
                            }
                        }
                    }
                    tf-arrows := RowArrows {
                        pos <=> tf.content-x;
                        content: tf.content-width;
                    }
                }
            }

            // ── inspector: una tarjeta redondeada a la altura de la vista previa
            VerticalLayout {
                padding-top: 16px;
                padding-right: 16px;
                padding-bottom: 16px;
            Rectangle {
                width: 330px;
                vertical-stretch: 1;
                background: Ui.p.panel;
                border-radius: 12px;
                border-width: 1px;
                border-color: Ui.p.frame;
                clip: true;
                VerticalLayout {
                    // colores
                    // alturas enteras y sin estirarse: si el layout reparte un sobrante de fracciones de píxel
                    // entre las filas, todo lo de abajo queda a medio píxel (borroso)
                    VerticalLayout {
                        vertical-stretch: 0;
                        padding: 14px;
                        padding-bottom: 10px;
                        spacing: 6px;
                        HorizontalLayout {
                            height: 26px;
                            Cap { text: Ui.t("COLOURS", "COLORES"); vertical-alignment: center; horizontal-stretch: 1; }
                            Seg {
                                items: [Ui.t("DARK", "OSCURO"), Ui.t("LIGHT", "CLARO")];
                                current: root.edit-light ? 1 : 0;
                                picked(k) => { root.set-edit-light(k == 1); }
                            }
                        }
                        VerticalLayout {
                            spacing: 0px;
                            for e in root.palette: ColorRow {
                                entry: e;
                                changed(hx) => { root.set-palette(e.key, hx); }
                            }
                        }
                    }
                    Hairline { }
                    // timeline
                    VerticalLayout {
                        vertical-stretch: 0;
                        padding: 14px;
                        padding-bottom: 10px;
                        spacing: 4px;
                        HorizontalLayout {
                            height: 22px;
                            Cap { text: "TIMELINE"; vertical-alignment: center; }
                        }
                        Text {
                            text: Ui.t("Tick a colour to set it by hand.", "Marca un color para fijarlo a mano.");
                            color: Ui.p.muted;
                            font-size: 11px;
                            height: 16px;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            spacing: 0px;
                            for e in root.timeline: TlRow {
                                entry: e;
                                changed(hx) => { root.set-override(e.key, hx); }
                                toggled(on) => { root.toggle-override(e.key, on); }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Hairline { }
                    // instalar
                    VerticalLayout {
                        vertical-stretch: 0;
                        padding: 14px;
                        spacing: 8px;
                        Cap { text: Ui.t("INSTALL TO", "INSTALAR EN"); }
                        if root.targets.length == 0: Text {
                            text: Ui.t("After Effects wasn't found in Program Files.", "No se encontró After Effects en Program Files.");
                            color: Ui.p.muted;
                            font-size: 11.5px;
                            wrap: word-wrap;
                        }
                        // con muchas versiones instaladas la lista se desplaza (máximo 4 filas a la vista), así los
                        // botones de abajo siempre caben
                        tgt-list := Flickable {
                            height: min(root.targets.length, 4) * 30px;
                            content-height: root.targets.length * 30px;
                        VerticalLayout {
                            width: parent.width;
                            spacing: 0px;
                            for t in root.targets: Rectangle {
                                height: 30px;
                                border-radius: 6px;
                                background: tta.has-hover ? Ui.p.raised.with-alpha(0.6) : transparent;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 10px;
                                    VerticalLayout { alignment: center; Check { checked: t.selected; } }
                                    Text { text: t.label; color: Ui.p.text; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                                    Text {
                                        text: t.status;
                                        color: Ui.p.muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                                tta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-target(t.id, !t.selected); }
                                }
                            }
                        }
                        // fundido abajo mientras queden versiones por ver
                        Rectangle {
                            x: 0;
                            y: parent.height - self.height;
                            width: parent.width;
                            height: 22px;
                            opacity: tgt-list.content-y > tgt-list.height - tgt-list.content-height + 1px ? 1 : 0;
                            animate opacity { duration: 160ms; }
                            background: @linear-gradient(180deg, Ui.p.panel.with-alpha(0) 0%, Ui.p.panel 100%);
                        }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            padding-top: 4px;
                            Btn {
                                text: Ui.t("Restore", "Restaurar");
                                enabled: !root.busy;
                                clicked => { root.restore(); }
                            }
                            Btn {
                                horizontal-stretch: 1;
                                text: root.busy ? Ui.t("Working…", "Aplicando…") : Ui.t("Apply theme", "Aplicar tema");
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.apply(); }
                            }
                        }
                    }
                }
            }
            }
        }
    }

    // la misma luz, muy tenue, por encima del contenido (no recibe clics)
    // (imagen con tramado: el degradado radial del renderizador por software hacía anillos)
    Image {
        x: 31px + 34px * Math.sin(root.lt * 19deg) - 70px;
        y: 26px + 24px * Math.cos(root.lt * 14deg) - 60px;
        width: 322px;
        height: 312px;
        source: Ui.glow-image(Ui.p.accent, 0.07, 420, 3, -70, -60, 322, 312);
        image-fit: fill;
    }

    // aviso de estado, centrado en la ventana
    HorizontalLayout {
        x: 260px;
        y: 4px;
        width: max(0px, root.width - 520px);
        height: 44px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                max-width: 520px;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    ring := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 22px;
                        height: 22px;
                        border-radius: self.width / 2;
                        border-width: 1.5px;
                        border-color: root.status-color;
                        opacity: 0;
                    }
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.status-color;
                        opacity: root.busy ? 0.4 + 0.6 * Math.abs(Math.sin(animation-tick() / 3ms * 1deg)) : 1;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0;
                    border-radius: 7px;
                    // un error se puede abrir entero (los largos se recortan con "…")
                    background: root.status-error && msg-ta.has-hover ? #f38ba8.with-alpha(0.10) : transparent;
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        msg := Text {
                            text: root.status;
                            color: root.status-error ? #f38ba8 : Ui.p.text.mix(Ui.p.muted, 0.4);
                            font-size: 12.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    msg-ta := TouchArea {
                        enabled: root.status-error;
                        mouse-cursor: root.status-error ? pointer : default;
                        clicked => { root.open-log(); }
                    }
                }
                if root.status-action != "" : Rectangle {
                    height: 24px;
                    width: act-label.preferred-width + 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 12px;
                    background: act-ta.pressed ? root.status-color.with-alpha(0.32) : act-ta.has-hover ? root.status-color.with-alpha(0.22) : root.status-color.with-alpha(0.13);
                    border-width: 1px;
                    border-color: root.status-color.with-alpha(0.55);
                    animate background { duration: 120ms; }
                    act-label := Text {
                        text: root.status-action;
                        color: root.status-color;
                        font-size: 11.5px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    act-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.status-act(); }
                    }
                }
            }
            states [
                lit when root.flash > 0.5: {
                    ring.width: 8px;
                    ring.height: 8px;
                    ring.opacity: 1;
                    msg.color: root.status-color;
                    in {
                        animate ring.width, ring.height, ring.opacity, msg.color { duration: 0ms; }
                    }
                    out {
                        animate ring.width, ring.height { duration: 750ms; easing: ease-out; }
                        animate ring.opacity { duration: 750ms; easing: ease-in; }
                        animate msg.color { duration: 1200ms; easing: ease-in-out; }
                    }
                }
            ]
        }

    }

    // línea fina entre los ajustes y los botones de ventana
    Rectangle {
        x: root.width - 104px;
        y: 16px;
        width: 1px;
        height: 20px;
        background: Ui.p.frame;
    }

    HorizontalLayout {
        x: root.width - 92px;
        y: 15px;
        width: 78px;
        height: 22px;
        spacing: 6px;
        WinBtn { kind: 0; clicked => { root.win-minimize(); } }
        WinBtn { kind: 1; maxed: root.is-max; clicked => { root.win-maximize(); } }
        WinBtn { kind: 2; clicked => { root.win-close(); } }
    }

    // bordes para cambiar el tamaño (0 N, 1 S, 2 E, 3 O, 4 NE, 5 NO, 6 SE, 7 SO)
    for z in [
        { d: 0, x: 8px, y: 0px, w: root.width - 16px, h: 5px },
        { d: 1, x: 8px, y: root.height - 5px, w: root.width - 16px, h: 5px },
        { d: 2, x: root.width - 5px, y: 32px, w: 5px, h: root.height - 40px },
        { d: 3, x: 0px, y: 8px, w: 5px, h: root.height - 16px },
        { d: 5, x: 0px, y: 0px, w: 8px, h: 8px },
        { d: 6, x: root.width - 8px, y: root.height - 8px, w: 8px, h: 8px },
        { d: 7, x: 0px, y: root.height - 8px, w: 8px, h: 8px },
    ]: TouchArea {
        x: z.x;
        y: z.y;
        width: z.w;
        height: z.h;
        enabled: !root.is-max;
        mouse-cursor: z.d == 0 || z.d == 1 ? ns-resize : z.d == 2 || z.d == 3 ? ew-resize : z.d == 5 || z.d == 6 ? nwse-resize : nesw-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.start-resize(z.d); }
        }
    }
}
